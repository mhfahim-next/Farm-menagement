# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI chat assistant (optional). Server-side only, never expose it to the browser.
# Get a key at https://console.anthropic.com. Without it the assistant says it is not set up.
ANTHROPIC_API_KEY=
# Optional: override the model (default is the cheapest, claude-haiku-5-5).
# AI_MODEL=claude-haiku-5-5
