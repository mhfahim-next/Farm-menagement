# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI chat assistant (optional). Server-side only; never expose these to the browser.
# Which service answers is chosen by a super admin in Admin -> AI assistant. Set the key for the one you use:
#   Claude (Anthropic), cheapest model by default: https://console.anthropic.com
ANTHROPIC_API_KEY=
#   Gemini (Google, has a free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
#   Custom OpenAI-compatible service (Groq, OpenRouter, Ollama...): key here, base URL + model in the admin page
AI_API_KEY=

# Payments (optional). bKash / Nagad / Rocket / Upay / bank need nothing here: set them up in Admin -> Payments.
# Online gateways (server-side only). The service-role key lets the server mark a checked online payment paid.
SUPABASE_SERVICE_ROLE_KEY=
#   SSLCommerz: https://developer.sslcommerz.com (sandbox) / merchant panel (live). SSLCOMMERZ_LIVE=true for real payments.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=
#   Stripe: Dashboard -> Developers -> API keys / Webhooks (endpoint /api/payments/stripe/webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
